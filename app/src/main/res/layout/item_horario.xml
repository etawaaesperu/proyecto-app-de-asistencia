<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dfs_surface"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvNombreEmpleado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Empleado"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dfs_text" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha: --/--/----"
            android:textSize="13sp"
            android:textColor="@color/dfs_muted"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvHoras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07:00 → 17:00"
            android:textSize="13sp"
            android:textColor="@color/dfs_muted"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvObservaciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/dfs_muted"
            android:textStyle="italic"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
